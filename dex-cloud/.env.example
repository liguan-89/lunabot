# DEX Cloud — copy to .env beside compose.yaml and fill in.

DEXCLOUD_ORIGIN=https://cloud.dexai.vip
DEXCLOUD_HOST=0.0.0.0
DEXCLOUD_PORT=8791
DEXCLOUD_DB=/data/dex-cloud.db
DEXCLOUD_TRUST_PROXY=1

# Where release files live on the volume.
DEXCLOUD_APK_PATH=/data/downloads/dexbot.apk
DEXCLOUD_UPDATE_PATH=/data/downloads/update.json
DEXCLOUD_LANDING_PATH=/data/downloads/landing.html
DEXCLOUD_LATEST_VERSION=2.0.0

# Relay token signing. Generate once:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DEXCLOUD_RELAY_TOKEN_SEED=
DEXCLOUD_RELAY_TOKEN_KID=k1
DEXCLOUD_RELAY_NODES=relay1.dexai.vip

# Sign-in email. Set one of these in production. Without either, only
# DEXCLOUD_DEV_CODES=1 prints codes to the service log (never use that in production).
DEXCLOUD_EMAIL_FROM=DEX BOT <noreply@cloud.dexai.vip>
DEXCLOUD_SMTP_URL=
DEXCLOUD_RESEND_API_KEY=
DEXCLOUD_DEV_CODES=0

DEXCLOUD_SIGNUP_OPEN=1
DEXCLOUD_SESSION_DAYS=30
DEXCLOUD_PLAN_MODE=pro
DEXCLOUD_ADMIN_EMAILS=
