# Luna Bot Cloud — copy to .env beside compose.yaml and fill in.

LUNABOT_CLOUD_ORIGIN=https://cloud.dexai.vip
LUNABOT_CLOUD_HOST=0.0.0.0
LUNABOT_CLOUD_PORT=8791
LUNABOT_CLOUD_DB=/data/dex-cloud.db
LUNABOT_CLOUD_TRUST_PROXY=1

# Where release files live on the volume.
LUNABOT_CLOUD_APK_PATH=/data/downloads/dexbot.apk
LUNABOT_CLOUD_UPDATE_PATH=/data/downloads/update.json
LUNABOT_CLOUD_LANDING_PATH=/data/downloads/landing.html
# Desktop installers and electron-updater metadata (`latest-mac.yml`, …),
# served at https://cloud.dexai.vip/desktop/<file>.
LUNABOT_CLOUD_DESKTOP_DIR=/data/downloads/desktop
LUNABOT_CLOUD_LATEST_VERSION=2.0.0

# Relay token signing. Generate once:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
LUNABOT_CLOUD_RELAY_TOKEN_SEED=
LUNABOT_CLOUD_RELAY_TOKEN_KID=k1
LUNABOT_CLOUD_RELAY_NODES=cloud.dexai.vip

# Sign-in email. Set one of these in production. Without either, only
# LUNABOT_CLOUD_DEV_CODES=1 prints codes to the service log (never use that in production).
LUNABOT_CLOUD_EMAIL_FROM=Luna Bot <noreply@cloud.dexai.vip>
LUNABOT_CLOUD_SMTP_URL=
LUNABOT_CLOUD_RESEND_API_KEY=
LUNABOT_CLOUD_DEV_CODES=0

LUNABOT_CLOUD_SIGNUP_OPEN=1
LUNABOT_CLOUD_SESSION_DAYS=30
LUNABOT_CLOUD_PLAN_MODE=pro
LUNABOT_CLOUD_ADMIN_EMAILS=

# Hosted Cloud desktops.
LUNABOT_CLOUD_DOCKER_SOCKET=/var/run/docker.sock
LUNABOT_CLOUD_CLOUD_IMAGE=lunabot-cloud-home:local
LUNABOT_CLOUD_CLOUD_NETWORK=dexcloud
LUNABOT_CLOUD_CLOUD_HOST_SUFFIX=cloud.dexai.vip
LUNABOT_CLOUD_CLOUD_MEMORY_MB=1536
LUNABOT_CLOUD_CLOUD_DISK_GB=10
LUNABOT_CLOUD_CLOUD_MAX_DISK_GB=20
LUNABOT_CLOUD_CLOUD_MAX_PER_ACCOUNT=1
LUNABOT_CLOUD_ROUTER_PORT=8792
