# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=lunabot
LUNABOT_BIND_ADDRESS=127.0.0.1
LUNABOT_HTTP_PORT=8080
# Leave empty to use http://localhost:${LUNABOT_HTTP_PORT:-8080}.
LUNABOT_PUBLIC_URL=
# Leave empty to inherit LUNABOT_PUBLIC_URL.
LUNABOT_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set LUNABOT_PUBLIC_URL to https:// followed by the same hostname.
# Requires LUNABOT_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
LUNABOT_HTTPS_HOST=
LUNABOT_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
LUNABOT_LOCAL_IMAGE=lunabot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
LUNABOT_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
LUNABOT_DATA_EXTERNAL=false
