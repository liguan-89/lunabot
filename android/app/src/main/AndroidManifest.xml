<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Opt-in "always on" background connection (Settings toggle, default off).
      FOREGROUND_SERVICE_CONNECTED_DEVICE rather than dataSync: this service
      exists to keep the pairing to the paired computer alive, not to move
      data in bulk, and dataSync foreground services face a ~6h/24h system
      timeout on Android 15+ that connectedDevice does not.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      Settings → About → Check for updates downloads the next signed build and
      hands it to the system installer. The system still asks the person to
      confirm; this permission only allows the app to make that request.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Pairing QR only, and asked for only when the scanner is opened. The app is
      fully usable without it: the NSD list and a typed address are the other two
      ways in (§6), so a camera the user never grants costs nothing.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!--
      Phone apps as bot tools: the calendar and contacts. Asked at the Settings
      switches, never at startup, and only for a person who turns that app on.
      The app is fully usable without any of these permissions.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!--
      File reads as a bot tool, behind their own Settings switch: gallery
      photos through the media grant, and one folder the person picks with the
      system folder picker (a persisted tree grant). READ_EXTERNAL_STORAGE is
      the pre-Android-13 spelling of the photo grant.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!--
      Location as a bot tool, also behind its own Settings switch. Coarse
      registers as `limited` and precise as `full`; neither is asked at startup.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      SMS relay as a bot tool, behind the messages Settings switch like the
      grants above: RECEIVE_SMS pushes inbound texts to the computer and
      SEND_SMS sends the channel's reply to the number that wrote in. Drafts
      (PHONE_SEND_MESSAGE, a compose sheet the person taps Send on) ride the
      same switch; refused grants leave it off.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!--
      Composer dictation only. Asked at the mic button, never at startup — the
      app is fully usable without it, and the IME's own mic is not a substitute
      for this lifecycle (frozen base, partials, teardown).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!--
      Android 13+ NSD / Wi-Fi peer discovery. neverForLocation: we only browse
      for _dexbot._tcp, never derive physical location from the scan.
      Without this (and the multicast permission), NsdManager returns an empty
      list silently — the same footgun as missing NSLocalNetworkUsageDescription
      on iOS (briefing §19).
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        android:minSdkVersion="33"
        tools:targetApi="s" />
    <!--
      Android 17 (API 37): runtime local-network permission. Without the
      declaration and a grant, NSD browse and plain LAN sockets to the
      companion are blocked the same way iOS blocks Bonjour without
      NSLocalNetworkUsageDescription.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        android:minSdkVersion="37" />

    <!--
      Phone UI launch: the executor resolves an installed package's launcher
      intent before asking the shell helper to start it. Without this filter
      package visibility hides every app DEX BOT does not name, and every
      launch would answer "not installed" on API 30+.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      Package visibility (API 30+): without this, SpeechRecognizer cannot see
      RecognitionService providers and isRecognitionAvailable() can falsely
      report none — dictation would never start on modern devices.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".OpenMausApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenMausMobile">

        <!--
          Lets `:baselineprofile`'s Macrobenchmark instrument this build over
          adb, which is how baseline-prof.txt is regenerated. `shell` only: the
          marker needs an adb connection, so it grants nothing to another app.
          Ignored below API 29.
        -->
        <profileable
            android:shell="true"
            tools:targetApi="q" />

        <!--
          persistNever: nothing about this Activity, its launching Intent
          included, may be written to task state that survives a reboot. It only
          ever receives ACTION_MAIN or the sanitized Intent PairingLinkActivity
          builds, but a one-time pairing credential is not the kind of thing to
          protect by one layer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:persistableMode="persistNever"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The deep-link door. A pairing URL carries a one-time credential, and the
          system keeps a copy of an Activity's launching Intent — handing it back
          on restart, and under the default persistRootOnly writing a root
          Activity's Intent across a reboot. This one is therefore never the root
          of the main task (its own taskAffinity), never kept in history, never in
          recents, and never persisted. It moves the invite into process memory
          and starts MainActivity with an Intent carrying no data and no extras.
        -->
        <activity
            android:name=".PairingLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:persistableMode="persistNever"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- host and scheme are one match, not two alternatives; the
                 pair belongs in a single data tag. -->
            <intent-filter tools:ignore="IntentFilterUniqueDataAttributes">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="dexbot" />
                <!-- The pre-rebrand scheme: an old QR or saved link must still
                     open the trampoline, and the parser accepts both. -->
                <data
                    android:host="pair"
                    android:scheme="openmausbot" />
            </intent-filter>
        </activity>
        <!--
          Inbound share. The sending app's content URIs are granted to this
          Activity; it copies them into the app cache, starts MainActivity with
          no extras, finishes, and only then deposits the local payload in
          process memory. Same trampoline shape as pairing, for the same
          reason: MainActivity is the root of the main task.
          configChanges: no UI — absorb rotation/etc so a mid-copy recreation
          cannot orphan the first copy against a wiped inbox.
        -->
        <activity
            android:name=".ShareReceiveActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:persistableMode="persistNever"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>
        </activity>
        <!--
          The 25-second linger anchor (iOS buys the same window with
          beginBackgroundTask). An ordinary started service: no intent filter,
          no binder, no foreground service permission, no foregroundServiceType,
          and nothing to export — its only caller is this process, and its only
          effect is keeping this process out of the cached class while the
          window is open. stopWithTask: swiping the task away is the user
          saying they are done, so the window goes with it.
        -->
        <service
            android:name=".lifecycle.SessionLingerService"
            android:exported="false"
            android:stopWithTask="true" />

        <!--
          The opt-in "always on" counterpart to SessionLingerService above.
          stopWithTask="false" is the whole point: this must keep running when
          the user swipes the app away, which is exactly what the 25-second
          linger window above does not attempt.
        -->
        <service
            android:name=".lifecycle.AlwaysOnConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <!--
          Restarts AlwaysOnConnectionService after a reboot, only when the user
          left the Settings toggle on. Not exported beyond what BOOT_COMPLETED
          requires; carries no data and does nothing when the toggle is off.
        -->
        <receiver
            android:name=".lifecycle.AlwaysOnBootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          The 允许 / 拒绝 buttons on an approval notification. Explicit intents
          from this app's own PendingIntents, so it is not exported and has no
          filter: nothing else on the device can make it answer for the user.
        -->
        <receiver
            android:name=".notifications.ApprovalActionReceiver"
            android:exported="false" />

        <!--
          A bot-made reminder firing. The alarm is this app's own PendingIntent,
          so the receiver is not exported; the boot receiver puts the upcoming
          alarms back after a restart clears AlarmManager.
        -->
        <receiver
            android:name=".phone.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".phone.ReminderBootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Inbound SMS for the channels relay. BROADCAST_SMS on the receiver
          means only the system can deliver this broadcast; the receiver itself
          also gates on the messages switch before anything is posted upstream.
        -->
        <receiver
            android:name=".phone.SmsRelayReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
          RCS/5G messages never fire SMS_RECEIVED; the messaging app's own
          notification is the only readable signal. BIND_ here means the
          system alone may bind — the person still flips it on in Settings.
        -->
        <service
            android:name=".phone.SmsNotificationRelay"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          The same notification access, kept in this process for the bot's
          list tool: the last few titles and texts other apps posted. Nothing
          is relayed and nothing is persisted; the tool refuses to answer
          while the access is off.
        -->
        <service
            android:name=".phone.NoticeRelay"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Share sheet hand-off for exported transcripts. Not exported, no
          granted URI permissions by default: each share grants read access to
          one file for one Intent, and only for the receiving app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.transcripts"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          The copy a granted-folder file is shared through: SAF document URIs
          cannot be re-delegated, so the bytes are copied here and this provider
          grants the one receiving app read access to that copy.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!--
          Where the shell-identity phone-UI helper (app_process, uid 2000)
          hands its virtual-display binder over. Exported because shell must
          reach it, but gated behind INTERACT_ACROSS_USERS_FULL — shell has it,
          ordinary apps do not — and everything behind that gate (shell uid,
          self-reported uid/pid, installed APK path, one-time nonce, binder
          process identity) is re-checked in code, see
          PhoneUiHandoffHub.offer. multiprocess=false: one hub per process,
          and the helper only ever talks to the app's own process.
        -->
        <provider
            android:name=".phoneui.shell.PhoneUiHandoffProvider"
            android:authorities="${applicationId}.phoneui.helper"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          The phone-UI reader service: reads the window tree of the shell
          helper's virtual displays only. Exported because the system Settings
          process binds it across uid boundaries; BIND_ACCESSIBILITY_SERVICE is
          a signature permission held by the system, so ordinary apps cannot
          bind. Its capability ceiling lives in
          @xml/phoneui_accessibility_service — window state events,
          generic feedback, window retrieval with view ids; no gestures, no
          screenshots, no key filtering.
        -->
        <service
            android:name=".phoneui.PhoneUiAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phoneui_accessibility_service" />
        </service>

        <!--
          Filled by the pairing notification's shade reply. Unexported: the
          notification's explicit PendingIntent is the only way in, and the code
          it carries is checked before use.
        -->
        <receiver
            android:name=".phoneui.PhoneUiPairingReplyReceiver"
            android:exported="false" />
    </application>
</manifest>
