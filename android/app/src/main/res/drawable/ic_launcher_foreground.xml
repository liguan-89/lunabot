<?xml version="1.0" encoding="utf-8"?>
<!--
  Luna Bot's launcher portrait, matching build/icon.svg (the desktop icon): the
  white disc bleeds off the right and bottom of the black tile, with two tilted
  pill eyes. The art is scaled into the 72dp visible window with an 18dp
  parallax margin on each side, so the launcher's mask frames it exactly as the
  desktop tile frames the same drawing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:scaleX="0.6666667"
        android:scaleY="0.6666667"
        android:translateX="170.6667"
        android:translateY="170.6667">
        <!-- The disc: cx 650, cy 650, r 560. It runs past the tile edge on the
             right and bottom, exactly as build/icon.svg draws it. -->
        <path
            android:fillColor="#FFF7F3ED"
            android:pathData="M 650.000 90.000 A 560.000 560.000 0 1 0 650.000 1210.000 A 560.000 560.000 0 1 0 650.000 90.000 Z" />
        <group
            android:rotation="-16.7"
            android:pivotX="469.023"
            android:pivotY="628.669">
            <path
                android:fillColor="#FF1C1C1E"
                android:pathData="M 469.023 491.469 A 70.000 70.000 0 0 1 539.023 561.469 L 539.023 695.869 A 70.000 70.000 0 0 1 399.023 695.869 L 399.023 561.469 A 70.000 70.000 0 0 1 469.023 491.469 Z" />
        </group>
        <group
            android:rotation="-16.7"
            android:pivotX="830.977"
            android:pivotY="503.331">
            <path
                android:fillColor="#FF1C1C1E"
                android:pathData="M 830.977 366.131 A 70.000 70.000 0 0 1 900.977 436.131 L 900.977 570.531 A 70.000 70.000 0 0 1 760.977 570.531 L 760.977 436.131 A 70.000 70.000 0 0 1 830.977 366.131 Z" />
        </group>
    </group>
</vector>
