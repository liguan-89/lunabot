<?xml version="1.0" encoding="utf-8"?>
<!--
  DEX BOT's launcher portrait: the app's own bot face — a white disc and two
  tilted pill eyes on the black tile from ic_launcher_background.xml. The
  eyes are evenOdd holes, so the black background reads through them at
  every launcher mask.

  The disc is 600 units across (radius 300) inside the 626-unit safe circle,
  so the whole face survives a circular or squircle mask without the eyes
  ever being clipped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M 212.000 512.000 A 300.000 300.000 0 1 0 812.000 512.000 A 300.000 300.000 0 1 0 212.000 512.000 Z M 369.590 505.209 A 37.500 37.500 0 0 1 441.427 483.657 L 462.117 552.620 A 37.500 37.500 0 0 1 390.280 574.172 Z M 536.021 385.176 A 37.500 37.500 0 0 1 607.857 363.624 L 628.547 432.587 A 37.500 37.500 0 0 1 556.711 454.139 Z" />
</vector>
