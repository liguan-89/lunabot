        android:fillType="evenOdd"
        android:pathData="M 2.000 12.000 A 10.000 10.000 0 1 0 22.000 12.000 A 10.000 10.000 0 1 0 2.000 12.000 Z M 7.253 11.774 A 1.250 1.250 0 0 1 9.648 11.055 L 10.337 13.354 A 1.250 1.250 0 0 1 7.943 14.072 Z M 12.801 7.773 A 1.250 1.250 0 0 1 15.195 7.054 L 15.885 9.353 A 1.250 1.250 0 0 1 13.490 10.071 Z" />
