<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window background behind Compose. Without a dark variant the first
      frame of a dark-mode launch flashes white before the composition draws;
      the colour is `MinisTokens.CanvasDark`, the page the app actually opens on.
    -->
    <style name="Theme.LunaBotMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0B0B0C</item>
    </style>
</resources>
