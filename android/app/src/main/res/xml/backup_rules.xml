<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (API 23–30): exclude the Keystore-backed token prefs, and the
  permission-prompt bookkeeping.

  Connection DataStore may back up; the device token must not. The permission
  prefs are not a secret, but they record that this install has already used up
  its notification prompt — restoring that onto a fresh install, where the OS has
  reset the permission and would happily ask again, would show "Open notification
  settings" for a prompt that was never spent here.

  The onboarding markers are the same kind of device-local truth: they record
  which first-run steps this install has already shown and answered. Carried onto
  a fresh install they would skip the welcome and the notification explanation
  for someone who has seen neither.

  Both files have been renamed twice (`openmaus.*` → `dexbot.*` → `lunabot.*`).
  Every name is excluded, not just the current one: an install that has not yet
  run the rename chain still has the older file on disk, and the exclusion has
  to hold for it too.

  The roster cache is not carried either: it holds no secret, but it is
  device-local convenience the next live hydrate replaces wholesale, so
  restoring a stale fleet onto another device would show a roster the computer
  has long since changed — stamped with a confidence it has not earned.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="companion_device_token.xml" />
    <exclude
        domain="sharedpref"
        path="__androidx_security_crypto_encrypted_prefs__.xml" />
    <exclude
        domain="sharedpref"
        path="lunabot.permissions.xml" />
    <exclude
        domain="sharedpref"
        path="lunabot.onboarding.xml" />
    <exclude
        domain="sharedpref"
        path="dexbot.permissions.xml" />
    <exclude
        domain="sharedpref"
        path="dexbot.onboarding.xml" />
    <exclude
        domain="sharedpref"
        path="openmaus.permissions.xml" />
    <exclude
        domain="sharedpref"
        path="openmaus.onboarding.xml" />
    <!--
      The WeChat binding: an AES/GCM blob whose key is Keystore-bound, so a
      restored copy could never be read anyway. Excluded so it is not even
      carried, and the inbound images it downloaded with it.
    -->
    <exclude
        domain="sharedpref"
        path="lunabot.wechat.xml" />
    <exclude
        domain="file"
        path="wechat-images" />
    <exclude
        domain="file"
        path="roster-cache" />
    <!--
      The keyguard credential: Keystore-bound ciphertext that is unreadable off
      this phone anyway. Excluded so it is not even carried — a restored copy on
      another phone would be a password nobody could use and nobody deleted.
    -->
    <exclude
        domain="file"
        path="unlock" />
</full-backup-content>
