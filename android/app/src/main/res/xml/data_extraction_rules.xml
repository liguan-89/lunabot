<?xml version="1.0" encoding="utf-8"?>
<!--
  Device transfer / cloud backup (API 31+): never copy the device token, and never
  copy the permission-prompt bookkeeping.

  EncryptedSharedPreferences file is listed explicitly; Keystore key material is
  already device-bound, but the ciphertext must not leave the device either. The
  permission prefs travel to a device whose OS has its own idea of what has been
  asked, so carrying ours across would misread a re-askable install as one that
  had spent its prompt. The onboarding markers travel the same way and are
  excluded for the same reason: they say which first-run steps this install has
  already shown.

  Both files have been renamed twice (`openmaus.*` → `dexbot.*` → `lunabot.*`),
  so every name is excluded in both blocks: an install that has not yet run the
  rename chain still has the older file on disk.

  The roster cache is excluded too: device-local convenience the next live
  hydrate replaces wholesale, and a restored copy would show the new device a
  fleet saved by the old one as if the computer had just answered.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="companion_device_token.xml" />
        <exclude
            domain="sharedpref"
            path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude
            domain="sharedpref"
            path="lunabot.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="lunabot.onboarding.xml" />
        <exclude
            domain="sharedpref"
            path="dexbot.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="dexbot.onboarding.xml" />
        <exclude
            domain="sharedpref"
            path="openmaus.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="openmaus.onboarding.xml" />
        <exclude
            domain="sharedpref"
            path="lunabot.wechat.xml" />
        <exclude
            domain="file"
            path="wechat-images" />
        <exclude
            domain="file"
            path="roster-cache" />
        <exclude
            domain="file"
            path="unlock" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="companion_device_token.xml" />
        <exclude
            domain="sharedpref"
            path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude
            domain="sharedpref"
            path="lunabot.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="lunabot.onboarding.xml" />
        <exclude
            domain="sharedpref"
            path="dexbot.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="dexbot.onboarding.xml" />
        <exclude
            domain="sharedpref"
            path="openmaus.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="openmaus.onboarding.xml" />
        <exclude
            domain="sharedpref"
            path="lunabot.wechat.xml" />
        <exclude
            domain="file"
            path="wechat-images" />
        <exclude
            domain="file"
            path="roster-cache" />
        <exclude
            domain="file"
            path="unlock" />
    </device-transfer>
</data-extraction-rules>
